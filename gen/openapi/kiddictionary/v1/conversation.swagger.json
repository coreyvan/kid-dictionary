    "v1AgeBracket": {
      "type": "string",
      "enum": [
        "AGE_BRACKET_UNSPECIFIED",
        "AGE_BRACKET_LITTLE_ONES",
        "AGE_BRACKET_GROWING_MINDS",
        "AGE_BRACKET_PRE_TEENS"
      ],
      "default": "AGE_BRACKET_UNSPECIFIED",
      "description": "AgeBracket represents the target age group for explanations.\n\n - AGE_BRACKET_LITTLE_ONES: 0-5 years\n - AGE_BRACKET_GROWING_MINDS: 5-10 years\n - AGE_BRACKET_PRE_TEENS: 10+ years"
    },
    "v1ContentTier": {
      "type": "string",
      "enum": [
        "CONTENT_TIER_UNSPECIFIED",
        "CONTENT_TIER_NORMAL",
        "CONTENT_TIER_SENSITIVE",
        "CONTENT_TIER_CONTEXTUAL",
        "CONTENT_TIER_REDIRECT"
      ],
      "default": "CONTENT_TIER_UNSPECIFIED",
      "description": "ContentTier classifies topic sensitivity for response handling.\n\n - CONTENT_TIER_NORMAL: Standard topics - direct explanation\n - CONTENT_TIER_SENSITIVE: Death, divorce, etc. - soft guidance prefix\n - CONTENT_TIER_CONTEXTUAL: Religion, politics - request framing preference\n - CONTENT_TIER_REDIRECT: Harmful or off-purpose - polite decline"
    },
